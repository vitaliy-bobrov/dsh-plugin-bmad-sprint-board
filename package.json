{
    "name": "dsh-plugin-bmad-sprint-board",
    "version": "2.0.0",
    "type": "module",
    "description": "Read a BMAD v7 project in the Session sidebar: initiatives, epics, tickets and the gaps between them",
    "icon": "./icon.svg",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./locale/*.json": "./locale/*.json",
        "./package.json": "./package.json"
    },
    "files": [
        "LICENSE",
        "icon.svg",
        "client.js",
        "index.js",
        "cordis.patch.yml",
        "locale/*.json"
    ],
    "scripts": {
        "build": "node build.mjs",
        "check": "node build.mjs --check",
        "test": "node --test src/*.test.js"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": [
                "@deepseek-ai/dsh-client-ui-sidebar-right"
            ]
        },
        "bmad": {
            "version": "v7"
        }
    },
    "license": "MIT",
    "peerDependencies": {
        "@deepseek-ai/dsh": "^0.2.0-0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vitaliy-bobrov/dsh-plugin-bmad-sprint-board.git"
    },
    "keywords": [
        "dsh",
        "dsh-plugin",
        "bmad",
        "bmad-v7",
        "initiative",
        "tickets",
        "board"
    ]
}
